{
  "name": "@open-efb/desktop",
  "productName": "Open EFB",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "description": "Open EFB Windows companion",
  "author": "Open EFB contributors",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "dev": "node scripts/bundle.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "package:win": "electron-builder --win --x64 --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "@open-efb/server": "workspace:*",
    "@open-efb/shared": "workspace:*",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
