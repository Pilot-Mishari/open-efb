{
  "name": "@open-efb/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.json && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --external:express --external:pino --external:zod --outfile=dist/cli.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@open-efb/integrations": "workspace:*",
    "@open-efb/shared": "workspace:*",
    "express": "5.3.0",
    "pino": "10.4.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
